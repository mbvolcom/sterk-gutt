/* ══ COMPONENTS: buttons, cards, modals, forms ═════════════════ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  border:none;border-radius:8px;cursor:pointer;
  font-family:'DM Mono',monospace;font-weight:500;
  transition:all 0.15s;letter-spacing:1px;
  text-transform:uppercase;font-size:11px;
}
.btn-primary{
  background:var(--neon);color:#000;padding:14px 24px;
  font-size:12px;font-weight:500;letter-spacing:2px;
  box-shadow:0 0 20px var(--neon-glow);
  width:100%;
}
.btn-primary:hover{box-shadow:0 0 30px var(--neon-glow);}
.btn-primary:active{transform:scale(0.98);}
.btn-ghost{
  background:transparent;color:var(--neon);
  border:1px solid var(--border2);
  padding:10px 18px;font-size:10px;
}
.btn-ghost:active{background:var(--neon-dim);}
.btn-danger{
  background:transparent;color:var(--red);
  border:1px solid rgba(255,68,102,0.2);
  padding:8px 14px;font-size:10px;
}
.btn-sm{padding:7px 12px;font-size:10px;}
.btn-icon{
  width:32px;height:32px;border-radius:6px;padding:0;
  background:var(--surface2);border:1px solid var(--border);
  color:var(--muted2);font-size:16px;
  display:inline-flex;align-items:center;justify-content:center;
}

input,textarea,select{
  background:var(--surface2);
  border:1px solid var(--border2);
  border-radius:8px;
  color:var(--text);
  font-family:'DM Mono',monospace;
  font-size:13px;
  padding:10px 14px;
  width:100%;
  outline:none;
  transition:border-color 0.2s,box-shadow 0.2s;
  -webkit-appearance:none;
}
input:focus,textarea:focus,select:focus{
  border-color:var(--neon);
  box-shadow:0 0 0 2px var(--neon-dim);
}
input::placeholder,textarea::placeholder{color:var(--muted);}
select option{background:var(--surface2);}

label{font-size:10px;color:var(--muted2);letter-spacing:1.5px;text-transform:uppercase;display:block;margin-bottom:6px;}

/* ═══════════════════════════════════════
   HOME PAGE
═══════════════════════════════════════ */
#page-home{padding:20px 16px;padding-bottom:calc(var(--nav-h) + 28px);}

.home-hero{
  background:var(--bg2);
  border:1px solid var(--border2);
  border-radius:16px;
  padding:24px 20px;
  margin-bottom:24px;
  position:relative;
  overflow:hidden;
}
.home-hero::before{
  content:'';
  position:absolute;
  top:-40px;right:-40px;
  width:200px;height:200px;
  background:radial-gradient(circle,rgba(0,180,255,0.08) 0%,transparent 70%);
}
.home-hero-label{font-size:10px;letter-spacing:3px;color:var(--neon);text-transform:uppercase;margin-bottom:8px;}
.home-hero-title{font-family:'Bebas Neue',sans-serif;font-size:36px;letter-spacing:3px;color:#fff;line-height:1;margin-bottom:4px;}
.home-hero-sub{font-size:11px;color:var(--muted2);margin-bottom:20px;}

.recent-item{
  display:flex;align-items:center;gap:12px;
  padding:14px 16px;
  border-bottom:1px solid var(--border);
  cursor:pointer;
  transition:background 0.15s;
}
.recent-item:last-child{border-bottom:none;}
.recent-item:active{background:var(--surface2);}
.recent-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--neon);
  box-shadow:0 0 6px var(--neon-glow);
  flex-shrink:0;
}
.recent-info{flex:1;min-width:0;}
.recent-name{font-size:13px;color:var(--text);font-weight:500;}
.recent-meta{font-size:10px;color:var(--muted2);margin-top:2px;}
.recent-right{font-size:11px;color:var(--muted);text-align:right;}
.recent-sets{font-family:'Bebas Neue',sans-serif;font-size:18px;color:var(--neon);display:block;}

/* ═══════════════════════════════════════
   WORKOUT PICKER MODAL
═══════════════════════════════════════ */
.modal-overlay{
  position:fixed;inset:0;
  background:rgba(7,8,12,0.92);
  z-index:1000;
  display:none;
  flex-direction:column;
  align-items:stretch;
  padding:20px 16px;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
.modal-overlay.open{display:flex;}
.modal-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:20px;
}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:3px;color:#fff;}
.modal-close{
  width:36px;height:36px;border-radius:8px;
  background:var(--surface2);border:1px solid var(--border);
  color:var(--muted2);font-size:18px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}

.routine-pick-item{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:12px;
  padding:16px;
  margin-bottom:10px;
  cursor:pointer;
  transition:border-color 0.2s,background 0.2s;
  display:flex;align-items:center;gap:14px;
}
.routine-pick-item:active{background:var(--surface2);border-color:var(--border2);}
.routine-pick-icon{
  width:40px;height:40px;border-radius:8px;
  background:var(--neon-dim);border:1px solid var(--border2);
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;
}
.routine-pick-icon svg{width:18px;height:18px;stroke:var(--neon);}
.routine-pick-name{font-size:14px;font-weight:500;color:var(--text);}
.routine-pick-meta{font-size:10px;color:var(--muted2);margin-top:3px;}

.new-routine-btn{
  background:transparent;
  border:1px dashed var(--border2);
  border-radius:12px;
  padding:16px;
  width:100%;
  display:flex;align-items:center;gap:14px;
  cursor:pointer;
  color:var(--neon);
  font-family:'DM Mono',monospace;
  font-size:13px;
  margin-top:4px;
  transition:background 0.15s;
}
.new-routine-btn:active{background:var(--neon-dim);}

/* ═══════════════════════════════════════
   ACTIVE WORKOUT PAGE
═══════════════════════════════════════ */
#page-workout{padding:0;padding-bottom:calc(var(--nav-h) + 28px);}

